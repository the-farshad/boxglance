#!/usr/bin/env bash
set -euo pipefail

BAR_W="${BAR_W:-12}"
MAX_JOBS_PER_GPU="${MAX_JOBS_PER_GPU:-2}"
CPU_SAMPLE="${CPU_SAMPLE:-0.10}"

CONCISE=0
WATCH=0
INTERVAL=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      cat <<'EOF'
boxglance - a single-file terminal dashboard for CPU, memory, disk, and GPU stats

Usage:
  boxglance                  Print one snapshot and exit
  boxglance -c, --concise    Print a single condensed line instead of the full dashboard
  boxglance -w, --watch [SECONDS]
                              Refresh in place with live history graphs (default 1s; q quits)
  boxglance -l, --log FILE   Append one CSV row of metrics to FILE (for plotting later)
  boxglance --stats FILE     Print the min/max/avg over a CSV file written by --log, and exit
  boxglance -h, --help       Show this help message and exit

Flags can be combined, e.g. `boxglance --watch --concise` for a compact,
continuously-refreshing line that fits in a small pane or status bar, or
`boxglance --watch --log stats.csv` to log a data point on every refresh.

Environment variables:
  DISKS               Space-separated mount points to report (full mode only).
                       Default: auto-detected common mount points that exist
                       on the current host (/, /mnt/nvme, /data, /scratch, ...).
  BAR_W               Width of the meters, in cells (default: 12).
  MAX_JOBS_PER_GPU    Max GPU jobs listed per device before collapsing the
                       rest into "+N" (default: 2).
  CPU_SAMPLE          Sampling interval, in seconds, used to measure CPU
                       usage (default: 0.10). In --watch mode it applies to
                       the first refresh; later ones measure CPU usage over
                       the time since the previous refresh.
EOF
      exit 0
      ;;
    -w|--watch|watch)
      WATCH=1
      if [[ -n "${2:-}" && "$2" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        INTERVAL="$2"
        shift
      fi
      ;;
    -c|--concise)
      CONCISE=1
      ;;
    -l|--log)
      LOGFILE="${2:-}"
      if [[ -z "$LOGFILE" ]]; then
        echo "boxglance: --log requires a file path" >&2
        exit 1
      fi
      shift
      ;;
    --stats)
      STATSFILE="${2:-}"
      if [[ -z "$STATSFILE" ]]; then
        echo "boxglance: --stats requires a file path" >&2
        exit 1
      fi
      shift
      ;;
  esac
  shift
done

if [[ -z "${DISKS+x}" ]]; then
  DISKS="/"
  [[ -d /mnt/nvme ]] && DISKS="$DISKS /mnt/nvme"
  [[ -d /data ]] && DISKS="$DISKS /data"
  [[ -d /scratch ]] && DISKS="$DISKS /scratch"
fi

# ---------- colors and glyphs ----------

RESET=$'\e[0m'; BOLD=$'\e[1m'
RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; CYAN=$'\e[36m'   # concise line

# 256-color palette: a green -> yellow -> red gradient for meters and graphs, greys
# for text, and one border color per panel.
GC=()
for c in 41 77 113 149 185 221 215 209 203 197; do GC+=($'\e[38;5;'"$c"'m'); done
FG_TXT=$'\e[38;5;252m'; FG_LBL=$'\e[38;5;245m'; FG_DIM=$'\e[38;5;241m'; FG_OFF=$'\e[38;5;237m'
FG_TITLE=$'\e[1;38;5;231m'
BOX_SYS=$'\e[38;5;72m'; BOX_GPU=$'\e[38;5;104m'
GPC=()   # one color per GPU (cycled), for its graph and its number in the table
for c in 81 213 221 111 156 209 183 116; do GPC+=($'\e[1;38;5;'"$c"'m'); done

# Braille characters for graphs: each holds two samples (left and right dot columns)
# of 0-4 dots filled from the bottom. BR[left * 5 + right], built from UTF-8 bytes.
BR=()
LB=(0 64 68 70 71); RB=(0 128 160 176 184)
for l in 0 1 2 3 4; do
  for r in 0 1 2 3 4; do
    v=$(( LB[l] + RB[r] ))
    printf -v b2 '%02x' $(( 0xA0 + (v >> 6) )); printf -v b3 '%02x' $(( 0x80 + (v & 63) ))
    printf -v ch "\\xe2\\x$b2\\x$b3"
    BR+=("$ch")
  done
done

# ---------- helpers (plain bash: no process per value) ----------

has() { command -v "$1" >/dev/null 2>&1; }

# trim VAR...: strip leading and trailing whitespace from each named variable.
trim() {
  local _v _s
  for _v in "$@"; do
    _s="${!_v}"
    _s="${_s#"${_s%%[![:space:]]*}"}"
    _s="${_s%"${_s##*[![:space:]]}"}"
    printf -v "$_v" '%s' "$_s"
  done
}

# toint VAR...: round each named variable to an integer; anything that is not a
# number (such as nvidia-smi's "[N/A]") becomes 0.
toint() {
  local _v _x _n
  for _v in "$@"; do
    _x="${!_v//[[:space:]]/}"
    _n=0
    if [[ $_x =~ ^(-?)([0-9]*)(\.([0-9]))?[0-9]*$ && -n "${BASH_REMATCH[2]}${BASH_REMATCH[4]}" ]]; then
      _n=$(( 10#0${BASH_REMATCH[2]} + ${BASH_REMATCH[4]:-0} / 5 ))
      [[ -n "${BASH_REMATCH[1]}" ]] && _n=$(( -_n ))
    fi
    printf -v "$_v" '%d' "$_n"
  done
}

shorten() {
  local s="$1" n="$2"
  (( ${#s} > n )) && printf '%s…' "${s:0:$((n-1))}" || printf '%s' "$s"
}

# MB -> GB with one decimal.
gb() {
  local t=$(( ($1 * 10 + 512) / 1024 ))
  printf '%d.%d' $(( t / 10 )) $(( t % 10 ))
}

# Rounded integer percentage of $1 out of $2 (0 when $2 is not positive).
pct() {
  if (( $2 > 0 )); then printf '%d' $(( ($1 * 100 + $2 / 2) / $2 )); else printf 0; fi
}

# Traffic-light thresholds for the concise line: green below 70, yellow 70-89, red 90+.
color_pct() {
  local p="$1"
  [[ $p =~ ^-?[0-9]+$ ]] || p=0
  if (( p >= 90 )); then printf '%s' "$RED"
  elif (( p >= 70 )); then printf '%s' "$YELLOW"
  else printf '%s' "$GREEN"
  fi
}

# Gradient color of a 0-100 value.
gcol() {
  local p="$1"
  (( p < 0 )) && p=0
  (( p > 99 )) && p=99
  printf '%s' "${GC[p / 10]}"
}

# GPU/CPU temperature color (Celsius): blue when cool, through yellow, to red at 85+.
temp_color() {
  local c=39
  (( $1 >= 50 )) && c=75
  (( $1 >= 65 )) && c=221
  (( $1 >= 75 )) && c=209
  (( $1 >= 85 )) && c=197
  printf '\e[38;5;%sm' "$c"
}

# meter P [WIDTH]: one ■ per cell; filled cells take the gradient color of their
# position, so a fuller meter runs further into yellow and red; empty cells are dark.
meter() {
  local p="$1" w="${2:-$BAR_W}" f i s=""
  (( p < 0 )) && p=0
  (( p > 100 )) && p=100
  (( w < 4 )) && w=4
  f=$(( (p * w + 50) / 100 ))
  (( p > 0 && f == 0 )) && f=1
  for (( i = 0; i < w; i++ )); do
    if (( i < f )); then s+="${GC[i * 10 / w]}■"; else s+="$FG_OFF■"; fi
  done
  printf '%s%s' "$s" "$RESET"
}

# graph ROWS WIDTH VALUE...: braille area graph of 0-100 values, newest at the right;
# WIDTH characters show the last 2*WIDTH values. Drawn in GRAPH_COLOR when that is set;
# otherwise taller graphs are colored by height, one-row graphs by each character's value.
graph() {
  local h="$1" w="$2"; shift 2
  local -a v=("$@")
  local off row i a b la lb m line color
  off=$(( ${#v[@]} - 2 * w ))
  for (( row = h - 1; row >= 0; row-- )); do
    color="${GRAPH_COLOR:-}"
    [[ -z $color ]] && (( h > 1 )) && color="${GC[(row * 2 + 1) * 10 / (h * 2)]}"
    line="$color"
    for (( i = 0; i < w; i++ )); do
      a=0; b=0
      (( off + 2 * i >= 0 )) && a="${v[off + 2 * i]}"
      (( off + 2 * i + 1 >= 0 )) && b="${v[off + 2 * i + 1]}"
      la=$(( (a * h * 4 + 99) / 100 - row * 4 )); (( la < 0 )) && la=0; (( la > 4 )) && la=4
      lb=$(( (b * h * 4 + 99) / 100 - row * 4 )); (( lb < 0 )) && lb=0; (( lb > 4 )) && lb=4
      if (( row == 0 && la == 0 && lb == 0 )); then   # empty: a dim baseline keeps the graph's extent visible
        line+="$FG_OFF${BR[6]}$color"
        continue
      fi
      if (( h == 1 )) && [[ -z ${GRAPH_COLOR:-} ]]; then m=$(( a > b ? a : b )); line+="$(gcol "$m")"; fi
      line+="${BR[la * 5 + lb]}"
    done
    printf '%s%s' "$line" "$RESET"
    (( row > 0 )) && printf '\n'
  done
  return 0
}

# Visible width of a string, ignoring color codes.
vlen() {
  local s="$1" re=$'\e''\[[0-9;]*m'
  while [[ $s =~ $re ]]; do s="${s/"${BASH_REMATCH[0]}"/}"; done
  printf '%d' "${#s}"
}

# fitc TEXT WIDTH: TEXT padded or cut (with …) to WIDTH visible columns, colors kept.
fitc() {
  local s="$1" w="$2" plain="$1" out="" n=0 re=$'\e''\[[0-9;]*m' esc=$'^(\e\\[[0-9;]*m)'
  while [[ $plain =~ $re ]]; do plain="${plain/"${BASH_REMATCH[0]}"/}"; done
  if (( ${#plain} <= w )); then printf '%s%*s' "$s" $(( w - ${#plain} )) ''; return 0; fi
  while (( n < w - 1 )) && [[ -n $s ]]; do
    if [[ $s =~ $esc ]]; then out+="${BASH_REMATCH[1]}"; s="${s:${#BASH_REMATCH[1]}}"
    else out+="${s:0:1}"; s="${s:1}"; n=$(( n + 1 )); fi
  done
  printf '%s%s…' "$out" "$RESET"
}

repeat() { local s; printf -v s '%*s' "$2" ''; printf '%s' "${s// /$1}"; }

# Panels: box_top COLOR LEFT [RIGHT] draws "╭─┤ LEFT ├────┤ RIGHT ├─╮" and sets the
# panel color; box_line TEXT draws one row; box_bottom [HINT] closes the panel.
box_top() {
  BC="$1"
  local l="$2" r="${3:-}" n
  n=$(( COLS - 7 - $(vlen "$l") ))
  [[ -n $r ]] && n=$(( n - 5 - $(vlen "$r") ))
  (( n < 1 )) && n=1
  printf '%s╭─┤ %s%s%s%s ├%s' "$BC" "$FG_TITLE" "$l" "$RESET" "$BC" "$(repeat ─ "$n")"
  [[ -n $r ]] && printf '┤ %s%s%s ├─' "$FG_LBL" "$r" "$BC"
  printf '╮%s\n' "$RESET"
}

box_line() {
  printf '%s│%s %s %s│%s\n' "$BC" "$RESET" "$(fitc "$1" $(( COLS - 4 )))" "$BC" "$RESET"
}

box_bottom() {
  local h="${1:-}" n
  if [[ -n $h ]]; then
    n=$(( COLS - 7 - $(vlen "$h") )); (( n < 1 )) && n=1
    printf '%s╰─┤ %s%s%s ├%s╯%s\n' "$BC" "$FG_LBL" "$h" "$BC" "$(repeat ─ "$n")" "$RESET"
  else
    printf '%s╰%s╯%s\n' "$BC" "$(repeat ─ $(( COLS - 2 )))" "$RESET"
  fi
}

# cell LABEL_WIDTH LABEL PCT INFO: "label ■■■■ 42% info"; an empty PCT leaves out the meter.
cell() {
  local s
  printf -v s '%s%-*s%s ' "$FG_LBL" "$1" "$2" "$RESET"
  [[ -n $3 ]] && printf -v s '%s%s %s%3d%%%s ' "$s" "$(meter "$3")" "$(gcol "$3")" "$3" "$RESET"
  printf '%s%s%s%s' "$s" "$FG_TXT" "$4" "$RESET"
}

spinner() {
  local f=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏") now
  printf -v now '%(%s)T' -1
  printf '%s' "${f[now % ${#f[@]}]}"
}

uptime_short() {
  local s d h m
  read -r s _ < /proc/uptime
  s="${s%%.*}"
  d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
  if (( d > 0 )); then printf '%dd%02dh' "$d" "$h"
  elif (( h > 0 )); then printf '%dh%02dm' "$h" "$m"
  else printf '%dm' "$m"
  fi
}

# ---------- data ----------

# CPU usage from two /proc/stat samples. The first refresh samples over CPU_SAMPLE
# seconds (the wait runs in the background while the rest is gathered); later
# refreshes measure the whole time since the previous one.
cpu_sample() {
  local cpu user nice system idle iowait irq softirq steal rest
  read -r cpu user nice system idle iowait irq softirq steal rest < /proc/stat
  printf -v "$1" '%d' $(( idle + ${iowait:-0} ))
  printf -v "$2" '%d' $(( user + nice + system + idle + ${iowait:-0} + ${irq:-0} + ${softirq:-0} + ${steal:-0} ))
}

cpu_start() {
  cpu_sample CPU_IDLE0 CPU_TOTAL0
  sleep "$CPU_SAMPLE" &
  CPU_SLEEP=$!
}

cpu_pct() {
  local idle1 total1 t i
  [[ -n "${CPU_SLEEP:-}" ]] && wait "$CPU_SLEEP"
  CPU_SLEEP=""
  cpu_sample idle1 total1
  t=$(( total1 - CPU_TOTAL0 )); i=$(( idle1 - CPU_IDLE0 ))
  CPU_IDLE0="$idle1"; CPU_TOTAL0="$total1"
  if (( t > 0 )); then printf -v "$1" '%d' $(( ((t - i) * 100 + t / 2) / t )); else printf -v "$1" 0; fi
}

# Sets MT MU MA (RAM total, used, available) and ST SU (swap total, used), in MB.
read_mem() {
  local k a b c d e f
  MT=0 MU=0 MA=0 ST=0 SU=0
  while read -r k a b c d e f; do
    case "$k" in
      Mem:) MT="$a" MU="$b" MA="${f:-0}" ;;
      Swap:) ST="$a" SU="$b" ;;
    esac
  done < <(free -m)
}

# disk_pct MOUNT: sets DSIZE DUSED DP (percent) for MOUNT; fails if df has no answer.
disk_pct() {
  DSIZE="" DUSED="" DP=""
  { read -r _ && read -r _ DSIZE DUSED _ DP _; } < <(df -hP "$1" 2>/dev/null) || return 1
  DP="${DP%\%}"
  [[ -n "$DP" ]] || return 1
  toint DP
}

# gather full|light: collect everything one refresh shows. Runs in the main shell so
# the CPU baseline and the history survive between refreshes.
gather() {
  local idx uuid pid user proc mem gpu item pids m top_fd job_fd=""
  [[ -n "${CPU_TOTAL0:-}" ]] || cpu_start

  # Full refresh: start ps and the GPU job query now, so they run while the rest is gathered.
  if [[ $1 == full ]]; then
    exec {top_fd}< <(ps -eo pcpu=,pmem=,comm= 2>/dev/null | awk '
      { n = $0; sub(/^ *[^ ]+ +[^ ]+ +/, "", n)
        if (n == "ps") next                  # this ps call itself
        if (cn == "" || $1 + 0 > c) { c = $1 + 0; cn = n }
        if (mn == "" || $2 + 0 > m) { m = $2 + 0; mn = n } }
      END { printf "%s %.0f%%|%s %.0f%%\n", cn, c, mn, m }')
    has nvidia-smi && exec {job_fd}< <(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_memory \
      --format=csv,noheader,nounits 2>/dev/null || true)
  fi

  read_mem
  MP="$(pct "$MU" "$MT")"
  SP="$(pct "$SU" "$ST")"

  GPU_ROWS=""
  if has nvidia-smi; then
    GPU_ROWS="$(nvidia-smi \
      --query-gpu=index,uuid,name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw \
      --format=csv,noheader,nounits 2>/dev/null)" || GPU_ROWS=""
  fi

  if [[ $1 == light ]]; then
    disk_pct / || DP="-"
    cpu_pct CPUP
    return 0
  fi

  HOST="${HOSTNAME:-$(hostname)}"
  printf -v NOW '%(%H:%M:%S)T' -1
  UP="$(uptime_short)"
  CORES="$(nproc 2>/dev/null || echo 1)"
  (( CORES > 0 )) || CORES=1
  read -r LOAD1 _ < /proc/loadavg
  LOADP=0
  if [[ $LOAD1 =~ ^([0-9]+)\.([0-9][0-9]) ]]; then
    LOADP=$(( ((10#${BASH_REMATCH[1]} * 100 + 10#${BASH_REMATCH[2]}) + CORES / 2) / CORES ))
  fi

  # Top process by CPU and by memory (ps started above).
  TOPC="-" TOPM="-"
  IFS='|' read -r TOPC TOPM <&"$top_fd" || true
  exec {top_fd}<&-

  DISK_M=() DISK_P=() DISK_I=()
  for m in $DISKS; do
    [[ -e "$m" ]] || continue
    disk_pct "$m" || continue
    DISK_M+=("$m"); DISK_P+=("$DP"); DISK_I+=("$DUSED/$DSIZE")
  done

  # GPU jobs: one query for the processes, one ps for their owners.
  unset GPU_BY_UUID JOB_COUNT JOB_DESC USER_OF
  declare -gA GPU_BY_UUID=() JOB_COUNT=() JOB_DESC=() USER_OF=()
  if [[ -n "$GPU_ROWS" ]]; then
    while IFS=',' read -r idx uuid _; do
      trim idx uuid
      [[ -n "$idx" && -n "$uuid" ]] && GPU_BY_UUID["$uuid"]="$idx"
    done <<< "$GPU_ROWS"

    JOB_ROWS=""
    [[ -n "$job_fd" ]] && { read -r -d '' JOB_ROWS <&"$job_fd" || true; }

    pids=""
    while IFS=',' read -r _ pid _; do
      trim pid
      [[ $pid =~ ^[0-9]+$ ]] && pids+="${pids:+,}$pid"
    done <<< "$JOB_ROWS"
    if [[ -n "$pids" ]]; then
      while read -r pid user; do USER_OF["$pid"]="$user"; done < <(ps -o pid=,user= -p "$pids" 2>/dev/null || true)
    fi

    while IFS=',' read -r uuid pid proc mem; do
      trim uuid pid proc mem
      [[ -z "$uuid" || -z "$pid" ]] && continue
      toint mem
      gpu="${GPU_BY_UUID[$uuid]:-?}"
      JOB_COUNT["$gpu"]="$(( ${JOB_COUNT[$gpu]:-0} + 1 ))"
      if (( ${JOB_COUNT[$gpu]} <= MAX_JOBS_PER_GPU )); then
        item="$pid $(shorten "${USER_OF[$pid]:-?}" 7) $(shorten "${proc##*/}" 10) $(gb "$mem")G"
        JOB_DESC["$gpu"]="${JOB_DESC[$gpu]:+${JOB_DESC[$gpu]} · }$item"
      fi
    done <<< "$JOB_ROWS"
  fi

  [[ -n "$job_fd" ]] && exec {job_fd}<&-
  cpu_pct CPUP
  return 0
}

# History for the graphs (watch mode): CPU percent, and GPU utilization per device.
CPU_HIST=()
declare -A GPU_HIST=()
push_history() {
  local idx util h
  CPU_HIST+=("$CPUP")
  (( ${#CPU_HIST[@]} > 1000 )) && CPU_HIST=("${CPU_HIST[@]: -1000}")
  [[ -n "$GPU_ROWS" ]] || return 0
  while IFS=',' read -r idx _ _ _ util _; do
    trim idx
    toint util
    read -ra h <<< "${GPU_HIST[$idx]:-} $util"
    (( ${#h[@]} > 1000 )) && h=("${h[@]: -1000}")   # a longer offset than the array gives nothing
    GPU_HIST["$idx"]="${h[*]}"
  done <<< "$GPU_ROWS"
  return 0
}

# ---------- logging: append one CSV row of metrics, or summarize a log file ----------

log_line() {
  local file="$1" ts header row i util gu gt temp vp

  printf -v ts '%(%Y-%m-%d %H:%M:%S)T' -1
  header="timestamp,cpu_pct,mem_pct,swap_pct"
  row="$ts,$CPUP,$MP,$SP"

  if [[ -n "$GPU_ROWS" ]]; then
    i=0
    while IFS=',' read -r _ _ _ temp util gu gt _; do
      toint util gu gt temp
      vp="$(pct "$gu" "$gt")"
      header+=",gpu${i}_util_pct,gpu${i}_vram_pct,gpu${i}_temp_c"
      row+=",$util,$vp,$temp"
      i=$((i + 1))
    done <<< "$GPU_ROWS"
  fi

  # Header is written once, based on whatever is detected on the first run;
  # a GPU count that changes later will misalign columns in the CSV.
  [[ -s "$file" ]] || printf '%s\n' "$header" > "$file"
  printf '%s\n' "$row" >> "$file"
}

stats_report() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    echo "boxglance: log file not found: $file" >&2
    exit 1
  fi

  awk -F',' '
    NR == 1 { for (i = 2; i <= NF; i++) name[i] = $i; ncols = NF; next }
    NF < 2 { next }
    {
      for (i = 2; i <= NF && i <= ncols; i++) {
        v = $i + 0
        if (!(i in cnt) || v > max[i]) max[i] = v
        if (!(i in cnt) || v < min[i]) min[i] = v
        sum[i] += v
        cnt[i]++
      }
    }
    END {
      if (!ncols) { print "no data"; exit }
      printf "%-16s %8s %8s %8s %8s\n", "METRIC", "MIN", "MAX", "AVG", "SAMPLES"
      for (i = 2; i <= ncols; i++) {
        if (cnt[i] > 0) {
          printf "%-16s %8.1f %8.1f %8.1f %8d\n", name[i], min[i], max[i], sum[i] / cnt[i], cnt[i]
        }
      }
    }
  ' "$file"
}

# ---------- concise mode: everything condensed onto a single line ----------

render_concise() {
  local gpu_part="" util gu gt vp now
  if [[ -n "$GPU_ROWS" ]]; then
    while IFS=',' read -r _ _ _ _ util gu gt _; do
      toint util gu gt
      vp="$(pct "$gu" "$gt")"
      gpu_part+="${gpu_part:+ }$(color_pct "$util")$util%$RESET/$(color_pct "$vp")$vp%$RESET"
    done <<< "$GPU_ROWS"
  fi
  printf -v now '%(%H:%M:%S)T' -1
  printf '%s%s%s %s  CPU %s%s%%%s  MEM %s%s%%%s  DSK %s%s%%%s%s\n' \
    "$BOLD$CYAN" "${HOSTNAME:-$(hostname)}" "$RESET" "$now" \
    "$(color_pct "$CPUP")" "$CPUP" "$RESET" \
    "$(color_pct "$MP")" "$MP" "$RESET" \
    "$(color_pct "$DP")" "$DP" "$RESET" \
    "${gpu_part:+  GPU $gpu_part}"
}

# ---------- full dashboard: a system panel and a GPU panel ----------

render_full() {
  local -a l1=() p1=() i1=() l2=() p2=() i2=() c1=() c2=()
  local k n lw1=0 lw2=0 w1=0 w2=0 v line hint="" stacked=0
  local idx uuid name temp util mu mt pwr mp count total mem_txt pwr_txt jobs hdr
  local -A util_of=()
  local ngpu=0 watts=0 h

  (( WATCH )) && hint="q quit · every ${INTERVAL}s"

  # System panel rows, two cells each: cpu | load, ram | swap, disks in pairs, top.
  l1+=(cpu); p1+=("$CPUP"); i1+=("")
  l2+=(load); p2+=("$LOADP"); i2+=("$LOAD1 / ${CORES} cores")
  l1+=(ram); p1+=("$MP"); i1+=("$(gb "$MU") / $(gb "$MT")G  free $(gb "$MA")G")
  l2+=(swap); p2+=("$SP"); i2+=("$(gb "$SU") / $(gb "$ST")G")
  for (( k = 0; k < ${#DISK_M[@]}; k += 2 )); do
    l1+=("${DISK_M[k]}"); p1+=("${DISK_P[k]}"); i1+=("${DISK_I[k]}")
    if (( k + 1 < ${#DISK_M[@]} )); then
      l2+=("${DISK_M[k+1]}"); p2+=("${DISK_P[k+1]}"); i2+=("${DISK_I[k+1]}")
    else
      l2+=(""); p2+=(""); i2+=("")
    fi
  done
  l1+=("top cpu"); p1+=(""); i1+=("$TOPC")
  l2+=("top mem"); p2+=(""); i2+=("$TOPM")

  n=${#l1[@]}
  for (( k = 0; k < n; k++ )); do
    (( ${#l1[k]} > lw1 )) && lw1=${#l1[k]}
    (( ${#l2[k]} > lw2 )) && lw2=${#l2[k]}
  done
  for (( k = 0; k < n; k++ )); do
    c1+=("$(cell "$lw1" "${l1[k]}" "${p1[k]}" "${i1[k]}")")
    c2+=("$(cell "$lw2" "${l2[k]}" "${p2[k]}" "${i2[k]}")")
    v="$(vlen "${c1[k]}")"; (( v > w1 )) && w1=$v
    v="$(vlen "${c2[k]}")"; (( v > w2 )) && w2=$v
  done
  # Too narrow for two columns: one cell per row, with a shared label width.
  if (( w1 + 4 + w2 > COLS - 4 )); then
    stacked=1
    (( lw2 > lw1 )) && lw1=$lw2
    c1=() c2=()
    for (( k = 0; k < n; k++ )); do
      c1+=("$(cell "$lw1" "${l1[k]}" "${p1[k]}" "${i1[k]}")")
      c2+=("$(cell "$lw1" "${l2[k]}" "${p2[k]}" "${i2[k]}")")
    done
  fi

  box_top "$BOX_SYS" "$(spinner) $HOST" "$NOW · up $UP"
  for (( k = 0; k < n; k++ )); do
    if (( stacked )); then
      box_line "${c1[k]}"
    else
      line="$(fitc "${c1[k]}" "$w1")"
      [[ -n "${l2[k]}" ]] && line+="    ${c2[k]}"
      box_line "$line"
    fi
    if (( k == 0 && WATCH )); then          # CPU history under the cpu row
      while IFS= read -r g; do box_line "$g"; done < <(graph 2 $(( COLS - 4 )) "${CPU_HIST[@]}"; echo)
    fi
    (( stacked )) && [[ -n "${l2[k]}" ]] && box_line "${c2[k]}"
  done
  box_bottom

  # GPU panel.
  if [[ -z "$GPU_ROWS" ]]; then
    box_top "$BOX_GPU" "gpu"
    box_line "${FG_DIM}No NVIDIA GPU detected.$RESET"
    box_bottom "$hint"
    return 0
  fi

  while IFS=',' read -r _ _ _ _ _ _ _ pwr; do
    ngpu=$(( ngpu + 1 ))
    toint pwr
    watts=$(( watts + pwr ))
  done <<< "$GPU_ROWS"

  box_top "$BOX_GPU" "gpu" "$ngpu devices · ${watts}W"
  printf -v hdr '%s%2s  %-9s %-5s  %-*s  %-*s %-9s %5s  %s%s' "$FG_DIM" '#' name temp \
    $(( BAR_W + 5 )) util $(( BAR_W + 5 )) vram '' power jobs "$RESET"
  box_line "$hdr"

  while IFS=',' read -r idx uuid name temp util mu mt pwr; do
    trim idx name pwr
    toint temp util mu mt

    name="${name/NVIDIA /}"
    name="${name/GeForce /}"
    name="${name/Tesla /}"
    name="${name/RTX /}"
    name="$(shorten "$name" 9)"

    mp="$(pct "$mu" "$mt")"
    count="${JOB_COUNT[$idx]:-0}"

    if [[ $pwr =~ ^[0-9]*\.?[0-9]+$ ]]; then toint pwr; pwr_txt="${pwr}W"; else pwr_txt="N/A"; fi

    if (( mt > 0 )); then
      total="$(gb "$mt")"
      mem_txt="$(gb "$mu")/${total%.0}G"
    else
      mem_txt="N/A"
    fi

    if (( count == 0 )); then
      jobs="$FG_DIM—$RESET"
    else
      jobs="${JOB_DESC[$idx]:-}"
      (( count > MAX_JOBS_PER_GPU )) && jobs+=" · +$(( count - MAX_JOBS_PER_GPU ))"
      jobs="$BOLD$count$RESET $FG_LBL▸$RESET $FG_TXT$jobs$RESET"
    fi

    util_of["$idx"]="$util"
    printf -v line '%s%2s%s  %s%-9s%s %s%3d°C%s  %s %s%3d%%%s  %s %s%3d%%%s %s%-9s%s %s%5s%s  %s' \
      "${GPC[idx % ${#GPC[@]}]}" "$idx" "$RESET" "$BOLD" "$name" "$RESET" "$(temp_color "$temp")" "$temp" "$RESET" \
      "$(meter "$util")" "$(gcol "$util")" "$util" "$RESET" \
      "$(meter "$mp")" "$(gcol "$mp")" "$mp" "$RESET" "$FG_TXT" "$mem_txt" "$RESET" \
      "$FG_TXT" "$pwr_txt" "$RESET" "$jobs"
    box_line "$line"
  done <<< "$GPU_ROWS"
  (( WATCH )) && gpu_graphs
  box_bottom "$hint"
}

# Utilization history of every GPU (watch mode): the panel width is split into one pane
# per GPU, each in that GPU's color, with its number and current utilization on the left.
# Panes are at least 24 columns wide and wrap onto more rows when there are many GPUs.
gpu_graphs() {
  local iw=$(( COLS - 4 )) n ppr prow pw k j idx c top bot
  local -a ids=() h gl
  while IFS=',' read -r idx _; do trim idx; ids+=("$idx"); done <<< "$GPU_ROWS"
  n=${#ids[@]}
  ppr=$(( iw / 24 )); (( ppr < 1 )) && ppr=1; (( ppr > n )) && ppr=$n
  prow=$(( (n + ppr - 1) / ppr )); ppr=$(( (n + prow - 1) / prow ))   # balance the rows
  pw=$(( (iw - 2 * (ppr - 1)) / ppr ))
  for (( k = 0; k < n; k += ppr )); do
    top="" bot=""
    for (( j = k; j < k + ppr && j < n; j++ )); do
      idx="${ids[j]}"; c="${GPC[idx % ${#GPC[@]}]}"
      read -ra h <<< "${GPU_HIST[$idx]:-}"
      mapfile -t gl < <(GRAPH_COLOR="$c" graph 2 $(( pw - 5 )) "${h[@]}"; echo)
      top+="${top:+  }$c$(printf '%-4s' "gpu$idx")$RESET ${gl[0]}"
      bot+="${bot:+  }$FG_LBL$(printf '%3d%%' "${util_of[$idx]:-0}")$RESET ${gl[1]}"
    done
    box_line "$top"
    box_line "$bot"
  done
  return 0
}

render() { if (( CONCISE )); then render_concise; else render_full; fi; }

# ---------- main ----------

if (( ! WATCH )); then
  if [[ -n "${STATSFILE:-}" ]]; then
    stats_report "$STATSFILE"
    exit 0
  fi
  COLS="$(tput cols 2>/dev/null || echo 120)"
  if (( CONCISE )); then gather light; else gather full; fi
  [[ -n "${LOGFILE:-}" ]] && log_line "$LOGFILE"
  render
  exit 0
fi

# Watch: redraw in place (no blank flash) until q or Ctrl-C.
trap 'printf "\e[?25h\n"' EXIT
printf '\e[?25l\e[H\e[2J'
# usec TIME VAR: VAR = TIME (seconds, such as 1 or 0.25) in microseconds.
usec() {
  local s="${1%%.*}" f=""
  [[ $1 == *.* ]] && f="${1#*.}"
  f="${f}000000"
  printf -v "$2" '%d' $(( 10#0${s} * 1000000 + 10#${f:0:6} ))
}
usec "$INTERVAL" PERIOD_US
while true; do
  START_US="${EPOCHREALTIME//[^0-9]/}"
  COLS="$(tput cols 2>/dev/null || echo 120)"
  if [[ -n "${STATSFILE:-}" ]]; then
    frame="$(stats_report "$STATSFILE")"
  else
    if (( CONCISE )); then gather light; else gather full; fi
    [[ -n "${LOGFILE:-}" ]] && log_line "$LOGFILE"
    push_history
    frame="$(render)"
  fi
  printf '\e[H%s\e[K\e[J' "${frame//$'\n'/$'\e[K\n'}"
  # wait out the rest of the period (bash 5 has EPOCHREALTIME; otherwise wait a full period)
  WAIT="$INTERVAL"
  if [[ -n "$START_US" ]]; then
    LEFT=$(( PERIOD_US - (${EPOCHREALTIME//[^0-9]/} - START_US) ))
    (( LEFT < 50000 )) && LEFT=50000
    printf -v WAIT '%d.%06d' $(( LEFT / 1000000 )) $(( LEFT % 1000000 ))
  fi
  if read -rsn1 -t "$WAIT" key; then
    [[ $key == [qQ] ]] && exit 0
  elif (( $? <= 128 )); then
    sleep "$WAIT"   # no keyboard (input closed): wait instead of spinning
  fi
done
